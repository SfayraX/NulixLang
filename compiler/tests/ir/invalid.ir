; вызов в теле цикла меняет вариант к следующему проходу
func stale_lent_in_loop() -> i64 {
  d: Dir = make Dir.Left(const 5)
  i: i64 = const 0
  switch d {
    case Left {
      loop L [held: d, i] {
        v: i64 = copy d.Left.0
        call flip(borrow mut d)
        i = add.i64(copy i, const 1)
        c: bool = ge.i64(copy i, const 2)
        if c {
          break L
        } else { } [held: d, i]
      } [held: d, i]
    }
    case Right { }
  } [held: d, i]
  return copy i
}

; использование после перемещения
func move_twice() {
  t: Token = make Token(id: const 1)
  u: Token = move t
  v: Token = move t
  drop u
  drop v
}

; объявление заново, пока в переменной непростое значение
func redeclare_owned() {
  t: Token = make Token(id: const 1)
  local t: Token
}
