func make_pair() -> Pair {
  a: Token = make Token(id: const 1)
  b: Token = make Token(id: const 2)
  p: Pair = make Pair(a: move a, b: move b)
  return move p
}

func look2(p: Pair mut, t: Token) { }

func borrow_after_lend() {
  p: Pair = call make_pair()
  call look2(borrow mut p, borrow p.a)
  drop p
}

func look_t(t: Token) { }

func borrow_empty() {
